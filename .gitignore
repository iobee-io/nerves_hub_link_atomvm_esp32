_build/
deps/
*.beam
*.avm
erl_crash.dump
rebar3.crashdump

# Generated by `mix atomvm.application_bin` on every build.
examples/*/priv/application.bin

# Credentials: a WiFi password and a NervesHub shared secret. Each example
# ships a config.*.example to copy.
examples/*/src/config.erl
examples/*/lib/config.ex

# A local override, for building an example against a working copy of the
# transport rather than the published one.
examples/*/_checkouts/atomvm_websocket_client
